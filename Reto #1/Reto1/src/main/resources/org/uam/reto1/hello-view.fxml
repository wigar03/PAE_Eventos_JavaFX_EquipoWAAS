<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="550.0" prefWidth="860.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.uam.reto1.HelloController">
    
    <!-- Encabezado -->
    <top>
        <VBox styleClass="header-container" BorderPane.alignment="CENTER">
            <Label styleClass="header-title" text="Inventario de Pulpería" />
            <Label styleClass="header-subtitle" text="Reto #1 - Registro y consulta de productos con eventos JavaFX" />
        </VBox>
    </top>

    <!-- Contenido Principal -->
    <center>
        <HBox spacing="16.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
            </padding>
            
            <!-- Panel Izquierdo: Formulario de Registro -->
            <VBox prefWidth="300.0" spacing="12.0" styleClass="card-panel">
                <Label styleClass="section-title" text="Registro de Producto" />
                
                <VBox spacing="4.0">
                    <Label styleClass="field-label" text="Código del Producto:" />
                    <TextField fx:id="txtCodigo" promptText="Ej. P001" />
                </VBox>
                
                <VBox spacing="4.0">
                    <Label styleClass="field-label" text="Nombre / Descripción:" />
                    <TextField fx:id="txtNombre" promptText="Ej. Arroz Faisán 1lb" />
                </VBox>
                
                <VBox spacing="4.0">
                    <Label styleClass="field-label" text="Precio Unitario (C$):" />
                    <TextField fx:id="txtPrecio" promptText="Ej. 18.50" />
                </VBox>
                
                <VBox spacing="4.0">
                    <Label styleClass="field-label" text="Cantidad / Existencias:" />
                    <TextField fx:id="txtCantidad" promptText="Ej. 25" />
                </VBox>

                <!-- Botones de Acción (ActionEvent) -->
                <HBox spacing="10.0">
                    <Button fx:id="btnGuardar" maxWidth="Infinity" onAction="#onGuardar" styleClass="btn-primary" text="💾 Guardar" HBox.hgrow="ALWAYS" />
                    <Button fx:id="btnLimpiar" onAction="#onLimpiar" styleClass="btn-secondary" text="Limpiar" />
                </HBox>
            </VBox>

            <!-- Panel Derecho: Búsqueda con KeyEvent y Tabla -->
            <VBox spacing="12.0" styleClass="card-panel" HBox.hgrow="ALWAYS">
                <Label styleClass="section-title" text="Consulta Rápida de Existencias" />
                
                <!-- Búsqueda con KeyEvent (ENTER) -->
                <TextField fx:id="txtBuscar" onKeyPressed="#onBuscar" promptText="🔍 Ingrese el código y presione ENTER para buscar existencias..." />
                
                <!-- Mensaje de Resultado -->
                <Label fx:id="lblResultado" styleClass="lbl-resultado" text="Presione ENTER en el buscador para consultar existencias." wrapText="true" />

                <!-- Tabla de Productos -->
                <TableView fx:id="tblProductos" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colCodigo" prefWidth="90.0" text="Código" />
                        <TableColumn fx:id="colNombre" prefWidth="200.0" text="Nombre" />
                        <TableColumn fx:id="colPrecio" prefWidth="100.0" text="Precio (C$)" />
                        <TableColumn fx:id="colCantidad" prefWidth="100.0" text="Existencias" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </VBox>
        </HBox>
    </center>
</BorderPane>
