<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="550.0" prefWidth="860.0" style="-fx-font-family: 'Segoe UI', Arial, sans-serif; -fx-font-size: 13px; -fx-background-color: #f1f5f9;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.uam.reto1.HelloController">
    
    <!-- Encabezado -->
    <top>
        <VBox spacing="8.0" style="-fx-background-color: #2563eb; -fx-padding: 16 20;" BorderPane.alignment="CENTER">
            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <Button onAction="#volverAlMenu" text="← Volver al Menú Principal" style="-fx-background-color: #21262d; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 6 14; -fx-background-radius: 6; -fx-cursor: hand; -fx-border-color: #484f58; -fx-border-radius: 6;" />
                <Region HBox.hgrow="ALWAYS" />
            </HBox>
            <Label style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;" text="Inventario de Pulpería" />
            <Label style="-fx-text-fill: #e2e8f0; -fx-font-size: 12px;" text="Reto #1 - Registro y consulta de productos con eventos JavaFX" />
        </VBox>
    </top>

    <!-- Contenido Principal -->
    <center>
        <HBox spacing="16.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
            </padding>
            
            <!-- Panel Izquierdo: Formulario de Registro -->
            <VBox prefWidth="300.0" spacing="12.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #cbd5e1; -fx-border-width: 1; -fx-padding: 16;">
                <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="Registro de Producto" />
                
                <VBox spacing="4.0">
                    <Label style="-fx-font-weight: bold; -fx-text-fill: #475569; -fx-font-size: 12px;" text="Código del Producto:" />
                    <TextField fx:id="txtCodigo" promptText="Ej. P001" style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 6 8;" />
                </VBox>
                
                <VBox spacing="4.0">
                    <Label style="-fx-font-weight: bold; -fx-text-fill: #475569; -fx-font-size: 12px;" text="Nombre / Descripción:" />
                    <TextField fx:id="txtNombre" promptText="Ej. Arroz Faisán 1lb" style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 6 8;" />
                </VBox>
                
                <VBox spacing="4.0">
                    <Label style="-fx-font-weight: bold; -fx-text-fill: #475569; -fx-font-size: 12px;" text="Precio Unitario (C$):" />
                    <TextField fx:id="txtPrecio" promptText="Ej. 18.50" style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 6 8;" />
                </VBox>
                
                <VBox spacing="4.0">
                    <Label style="-fx-font-weight: bold; -fx-text-fill: #475569; -fx-font-size: 12px;" text="Cantidad / Existencias:" />
                    <TextField fx:id="txtCantidad" promptText="Ej. 25" style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 6 8;" />
                </VBox>

                <!-- Botones de Acción (ActionEvent) -->
                <HBox spacing="10.0">
                    <Button fx:id="btnGuardar" maxWidth="Infinity" onAction="#onGuardar" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 4; -fx-padding: 7 14; -fx-cursor: hand;" text="Guardar" HBox.hgrow="ALWAYS" />
                    <Button fx:id="btnLimpiar" onAction="#onLimpiar" style="-fx-background-color: #f1f5f9; -fx-text-fill: #334155; -fx-border-color: #cbd5e1; -fx-border-radius: 4; -fx-background-radius: 4; -fx-font-weight: bold; -fx-padding: 7 14; -fx-cursor: hand;" text="Limpiar" />
                </HBox>
            </VBox>

            <!-- Panel Derecho: Búsqueda con KeyEvent y Tabla -->
            <VBox spacing="12.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #cbd5e1; -fx-border-width: 1; -fx-padding: 16;" HBox.hgrow="ALWAYS">
                <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="Consulta Rápida de Existencias" />
                
                <!-- Búsqueda con KeyEvent (ENTER) -->
                <TextField fx:id="txtBuscar" onKeyPressed="#onBuscar" promptText="Ingrese el código y presione ENTER para buscar existencias..." style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 6 8;" />
                
                <!-- Mensaje de Resultado -->
                <Label fx:id="lblResultado" style="-fx-background-color: #f8fafc; -fx-border-color: #cbd5e1; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 8 12; -fx-text-fill: #1e293b; -fx-font-weight: bold;" text="Presione ENTER en el buscador para consultar existencias." wrapText="true" />

                <!-- Tabla de Productos -->
                <TableView fx:id="tblProductos" style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 4;" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colCodigo" prefWidth="90.0" text="Código" />
                        <TableColumn fx:id="colNombre" prefWidth="200.0" text="Nombre" />
                        <TableColumn fx:id="colPrecio" prefWidth="100.0" text="Precio (C$)" />
                        <TableColumn fx:id="colCantidad" prefWidth="100.0" text="Existencias" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </VBox>
        </HBox>
    </center>
</BorderPane>
