<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="560.0" prefWidth="900.0" style="-fx-font-family: 'Segoe UI', Arial, sans-serif; -fx-font-size: 13px; -fx-background-color: #f1f5f9;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.uam.reto2.HelloController">
    
    <!-- Parte Superior: MenuBar y ToolBar -->
    <top>
        <VBox>
            <!-- 1. Menús Catálogo, Ventas y Ayuda -->
            <MenuBar style="-fx-background-color: #ffffff; -fx-border-color: #cbd5e1; -fx-border-width: 0 0 1 0;">
                <menus>
                    <Menu text="Catálogo">
                        <items>
                            <MenuItem accelerator="Shortcut+N" onAction="#onNuevo" text="Nuevo Producto" />
                            <MenuItem accelerator="Shortcut+S" onAction="#onGuardar" text="Guardar" />
                            <SeparatorMenuItem />
                            <MenuItem onAction="#volverAlMenu" text="← Volver al Menú Principal" />
                            <MenuItem onAction="#onSalir" text="Salir" />
                        </items>
                    </Menu>
                    <Menu text="Ventas">
                        <items>
                            <MenuItem onAction="#onVender" text="Vender Producto Seleccionado" />
                            <MenuItem onAction="#onResumenVentas" text="Resumen de Inventario" />
                        </items>
                    </Menu>
                    <Menu text="Ayuda">
                        <items>
                            <MenuItem onAction="#onAcercaDe" text="Acerca de la Tienda..." />
                        </items>
                    </Menu>
                </menus>
            </MenuBar>

            <!-- 2. ToolBar con Nuevo, Guardar y Buscar -->
            <ToolBar style="-fx-background-color: #f8fafc; -fx-border-color: #cbd5e1; -fx-border-width: 0 0 1 0; -fx-padding: 6 12;">
                <items>
                    <Button onAction="#onNuevo" style="-fx-background-color: #ffffff; -fx-border-color: #cbd5e1; -fx-border-radius: 4; -fx-background-radius: 4; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 5 12;" text="Nuevo" />
                    <Button onAction="#onGuardar" style="-fx-background-color: #ffffff; -fx-border-color: #cbd5e1; -fx-border-radius: 4; -fx-background-radius: 4; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 5 12;" text="Guardar" />
                    <Separator orientation="VERTICAL" />
                    <TextField fx:id="txtBuscar" onKeyPressed="#onBuscarKeyPressed" prefWidth="240.0" promptText="Buscar por código o nombre..." style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 5 8;" />
                    <Button onAction="#onBuscar" style="-fx-background-color: #ffffff; -fx-border-color: #cbd5e1; -fx-border-radius: 4; -fx-background-radius: 4; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 5 12;" text="Buscar" />
                    <Separator orientation="VERTICAL" />
                    <Button onAction="#onVender" style="-fx-background-color: #16a34a; -fx-text-fill: white; -fx-border-radius: 4; -fx-background-radius: 4; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 5 12;" text="Vender" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button onAction="#volverAlMenu" text="← Volver al Menú" style="-fx-background-color: #21262d; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 5 12; -fx-background-radius: 6; -fx-cursor: hand; -fx-border-color: #484f58; -fx-border-radius: 6;" />
                </items>
            </ToolBar>
        </VBox>
    </top>

    <!-- Contenido Central: Formulario y Catálogo -->
    <center>
        <HBox spacing="16.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="12.0" left="16.0" right="16.0" top="12.0" />
            </padding>

            <!-- Panel Izquierdo: Formulario -->
            <VBox prefWidth="300.0" spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #cbd5e1; -fx-border-width: 1; -fx-padding: 14;">
                <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="Datos de la Artesanía" />

                <VBox spacing="3.0">
                    <Label style="-fx-font-weight: bold; -fx-text-fill: #475569; -fx-font-size: 12px;" text="Código:" />
                    <TextField fx:id="txtCodigo" promptText="Ej. ART-006" style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 5 8;" />
                </VBox>

                <VBox spacing="3.0">
                    <Label style="-fx-font-weight: bold; -fx-text-fill: #475569; -fx-font-size: 12px;" text="Nombre / Descripción:" />
                    <TextField fx:id="txtNombre" promptText="Ej. Tapiz Bordado Solentiname" style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 5 8;" />
                </VBox>

                <VBox spacing="3.0">
                    <Label style="-fx-font-weight: bold; -fx-text-fill: #475569; -fx-font-size: 12px;" text="Categoría:" />
                    <ComboBox fx:id="cbCategoria" maxWidth="Infinity" style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 3 6;" />
                </VBox>

                <VBox spacing="3.0">
                    <Label style="-fx-font-weight: bold; -fx-text-fill: #475569; -fx-font-size: 12px;" text="Precio (C$):" />
                    <TextField fx:id="txtPrecio" promptText="Ej. 450.00" style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 5 8;" />
                </VBox>

                <VBox spacing="3.0">
                    <Label style="-fx-font-weight: bold; -fx-text-fill: #475569; -fx-font-size: 12px;" text="Cantidad / Stock:" />
                    <TextField fx:id="txtCantidad" promptText="Ej. 10" style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 5 8;" />
                </VBox>

                <HBox spacing="10.0">
                    <Button maxWidth="Infinity" onAction="#onGuardar" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 4; -fx-padding: 6 14; -fx-cursor: hand;" text="Guardar" HBox.hgrow="ALWAYS" />
                    <Button onAction="#onLimpiar" style="-fx-background-color: #f1f5f9; -fx-text-fill: #334155; -fx-border-color: #cbd5e1; -fx-border-radius: 4; -fx-background-radius: 4; -fx-font-weight: bold; -fx-padding: 6 14; -fx-cursor: hand;" text="Limpiar" />
                </HBox>
            </VBox>

            <!-- Panel Derecho: TableView -->
            <VBox spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #cbd5e1; -fx-border-width: 1; -fx-padding: 14;" HBox.hgrow="ALWAYS">
                <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="Catálogo de Artesanías Nicaragüenses" />

                <TableView fx:id="tblProductos" style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 4;" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colCodigo" prefWidth="90.0" text="Código" />
                        <TableColumn fx:id="colNombre" prefWidth="220.0" text="Nombre" />
                        <TableColumn fx:id="colCategoria" prefWidth="100.0" text="Categoría" />
                        <TableColumn fx:id="colPrecio" prefWidth="100.0" text="Precio (C$)" />
                        <TableColumn fx:id="colCantidad" prefWidth="90.0" text="Stock" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </VBox>
        </HBox>
    </center>

    <!-- Barra de Estado Inferior -->
    <bottom>
        <HBox style="-fx-background-color: #f8fafc; -fx-border-color: #cbd5e1; -fx-border-width: 1 0 0 0; -fx-padding: 6 16;" BorderPane.alignment="CENTER">
            <Label fx:id="lblEstado" style="-fx-text-fill: #475569;" text="Listo." />
        </HBox>
    </bottom>
</BorderPane>
