<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="580.0" prefWidth="920.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.uam.reto2.HelloController">
    
    <!-- Parte Superior: MenuBar y ToolBar -->
    <top>
        <VBox>
            <!-- 1. Menús Catálogo, Ventas y Ayuda -->
            <MenuBar>
                <menus>
                    <Menu text="Catálogo">
                        <items>
                            <MenuItem accelerator="Shortcut+N" onAction="#onNuevo" text="Nuevo Producto" />
                            <MenuItem accelerator="Shortcut+S" onAction="#onGuardar" text="Guardar" />
                            <SeparatorMenuItem />
                            <MenuItem onAction="#onSalir" text="Salir" />
                        </items>
                    </Menu>
                    <Menu text="Ventas">
                        <items>
                            <MenuItem onAction="#onVender" text="Vender Producto Seleccionado" />
                            <MenuItem onAction="#onResumenVentas" text="Resumen de Inventario" />
                        </items>
                    </Menu>
                    <Menu text="Ayuda">
                        <items>
                            <MenuItem onAction="#onAcercaDe" text="Acerca de la Tienda..." />
                        </items>
                    </Menu>
                </menus>
            </MenuBar>

            <!-- 2. ToolBar con Nuevo, Guardar y Buscar -->
            <ToolBar>
                <items>
                    <Button onAction="#onNuevo" styleClass="btn-toolbar" text="➕ Nuevo" />
                    <Button onAction="#onGuardar" styleClass="btn-toolbar" text="💾 Guardar" />
                    <Separator orientation="VERTICAL" />
                    <TextField fx:id="txtBuscar" onKeyPressed="#onBuscarKeyPressed" prefWidth="240.0" promptText="🔍 Buscar por código o nombre..." />
                    <Button onAction="#onBuscar" styleClass="btn-toolbar" text="Buscar" />
                    <Separator orientation="VERTICAL" />
                    <Button onAction="#onVender" styleClass="btn-toolbar-sell" text="💰 Vender" />
                </items>
            </ToolBar>
        </VBox>
    </top>

    <!-- Contenido Central: Formulario y Catálogo con Imágenes -->
    <center>
        <HBox spacing="16.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="12.0" left="16.0" right="16.0" top="12.0" />
            </padding>

            <!-- Panel Izquierdo: Formulario -->
            <VBox prefWidth="300.0" spacing="10.0" styleClass="card-panel">
                <Label styleClass="section-title" text="Datos de la Artesanía" />

                <VBox spacing="3.0">
                    <Label styleClass="field-label" text="Código:" />
                    <TextField fx:id="txtCodigo" promptText="Ej. ART-006" />
                </VBox>

                <VBox spacing="3.0">
                    <Label styleClass="field-label" text="Nombre / Descripción:" />
                    <TextField fx:id="txtNombre" promptText="Ej. Tapiz Bordado Solentiname" />
                </VBox>

                <VBox spacing="3.0">
                    <Label styleClass="field-label" text="Categoría:" />
                    <ComboBox fx:id="cbCategoria" maxWidth="Infinity" />
                </VBox>

                <VBox spacing="3.0">
                    <Label styleClass="field-label" text="Precio (C$):" />
                    <TextField fx:id="txtPrecio" promptText="Ej. 450.00" />
                </VBox>

                <VBox spacing="3.0">
                    <Label styleClass="field-label" text="Cantidad / Stock:" />
                    <TextField fx:id="txtCantidad" promptText="Ej. 10" />
                </VBox>

                <HBox spacing="10.0">
                    <Button maxWidth="Infinity" onAction="#onGuardar" styleClass="btn-primary" text="💾 Guardar" HBox.hgrow="ALWAYS" />
                    <Button onAction="#onLimpiar" styleClass="btn-secondary" text="Limpiar" />
                </HBox>
            </VBox>

            <!-- Panel Derecho: TableView con Imágenes -->
            <VBox spacing="10.0" styleClass="card-panel" HBox.hgrow="ALWAYS">
                <Label styleClass="section-title" text="Catálogo de Artesanías Nicaragüenses" />

                <TableView fx:id="tblProductos" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colImagen" prefWidth="55.0" style="-fx-alignment: CENTER;" text="Foto" />
                        <TableColumn fx:id="colCodigo" prefWidth="85.0" text="Código" />
                        <TableColumn fx:id="colNombre" prefWidth="200.0" text="Nombre" />
                        <TableColumn fx:id="colCategoria" prefWidth="95.0" text="Categoría" />
                        <TableColumn fx:id="colPrecio" prefWidth="95.0" text="Precio (C$)" />
                        <TableColumn fx:id="colCantidad" prefWidth="80.0" text="Stock" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </VBox>
        </HBox>
    </center>

    <!-- Barra de Estado Inferior -->
    <bottom>
        <HBox styleClass="status-bar" BorderPane.alignment="CENTER">
            <Label fx:id="lblEstado" text="Listo." />
        </HBox>
    </bottom>
</BorderPane>
